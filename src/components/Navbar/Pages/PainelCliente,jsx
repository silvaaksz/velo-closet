import React from 'react';
import styles from './PainelCliente.module.css';

export default function PainelCliente({ usuarioLogado, setPaginaAtual, pedidosHistorico }) {
  return (
    <div className={styles.container}>
      <div className={styles.header}>
        <h2>Minha Conta (Painel do Cliente)</h2>
        <p>Bem-vindo(a), <strong>{usuarioLogado?.nome || 'Cliente'}</strong>!</p>
      </div>

      <div className={styles.grid}>
        <div className={styles.card}>
          <h3>Meus Dados</h3>
          <p><strong>Nome:</strong> {usuarioLogado?.nome}</p>
          <p><strong>E-mail:</strong> {usuarioLogado?.email}</p>
          <p><strong>Tipo de Conta:</strong> Consumidor</p>
          <button className={styles.btnAcao} onClick={() => alert('Funcionalidade de editar perfil')}>
            Editar Perfil
          </button>
        </div>

        <div className={styles.card}>
          <h3>Ações Rápidas</h3>
          <button className={styles.btnPrimary} onClick={() => setPaginaAtual('rastreio')}>
            Rastrear Pedidos (UC07)
          </button>
          <button className={styles.btnSecondary} onClick={() => setPaginaAtual('devolucao')}>
            Solicitar Devolução / SAC (UC13)
          </button>
          <button className={styles.btnSecondary} onClick={() => setPaginaAtual('produtos')}>
            Ir para o Catálogo
          </button>
        </div>
      </div>

      <div className={styles.pedidosSecao}>
        <h3>Meus Pedidos Recentes</h3>
        {pedidosHistorico && pedidosHistorico.length > 0 ? (
          <div className={styles.pedidosLista}>
            {pedidosHistorico.map((pedido, index) => (
              <div key={index} className={styles.pedidoCard}>
                <div>
                  <strong>Código: {pedido.codigo}</strong>
                  <p>Data: {pedido.data} | Status: <span className={styles.status}>{pedido.status}</span></p>
                  <p>Total: R$ {pedido.total.toFixed(2).replace('.', ',')}</p>
                </div>
                <button className={styles.btnRastrear} onClick={() => setPaginaAtual('rastreio')}>
                  Rastrear
                </button>
              </div>
            ))}
          </div>
        ) : (
          <p className={styles.semPedidos}>Você ainda não realizou nenhum pedido na plataforma.</p>
        )}
      </div>
    </div>
  );
}